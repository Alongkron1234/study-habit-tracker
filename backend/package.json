{
  "name": "study-habit-tracker-backend",
  "version": "0.1.0",
  "description": "Study Habit Tracker — Backend API (CPE 334)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node-pg-migrate -m src/db/migrations",
    "migrate:down": "node-pg-migrate -m src/db/migrations down",
    "seed": "node src/db/seeds/seed.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --runInBand",
    "test:watch": "jest --watch --runInBand"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "node-pg-migrate": "^7.4.0",
    "supertest": "^7.0.0"
  }
}

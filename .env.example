# ตัวอย่างค่า environment (ไม่ใช่ค่าจริง) คัดลอกเป็น .env แล้วกรอกเอง ห้าม commit .env
# ปรับชื่อ/ตัวแปรให้ตรงกับ stack ที่เลือก

# Runtime environment (production สำหรับ cloud, development สำหรับ local)
NODE_ENV=development

# ฐานข้อมูล (Cloud SQL or local PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/study_habit

# session / token
SESSION_SECRET=change-me
SESSION_TTL_HOURS=8
# Cookie Secure flag: true บน HTTPS (Cloud Run), false เมื่อรัน http://localhost (docker compose)
# ถ้าไม่ตั้ง = true เฉพาะ NODE_ENV=production
# ⚠ ห้ามใช้ false ใน production/Cloud Run — ใช้เฉพาะรันในเครื่องผ่าน http เท่านั้น
COOKIE_SECURE=false

# รัน seed (บัญชี demo) ตอน container เริ่มหรือไม่ — true เฉพาะ local/UAT, ห้ามเปิดกับ database จริง
# ค่าเริ่มต้นของ entrypoint = false (docker compose ตั้ง service migrate เป็น true ให้)
RUN_SEED=false

# พอร์ตฝั่ง host ที่ docker compose เปิดให้ (ค่าเริ่มต้นของ compose: 3002 / 5433)
DB_PORT=5433

# จำนวน connection สูงสุดต่อ instance (ไม่ตั้ง = 10) บน Cloud Run ตั้ง 5 เพราะ db-f1-micro รับได้ ~25 รวมทุก instance
DB_POOL_MAX=10

# พอร์ตสำหรับเซิร์ฟเวอร์ (Cloud Run กำหนด PORT อัตโนมัติ)
PORT=3000
APP_PORT=3000
TZ=Asia/Bangkok
